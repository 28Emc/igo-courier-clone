---
import 'swiper/css';
import 'swiper/css/navigation';
import Layout from "../layouts/Layout.astro";
import DynamicImage from "../components/DynamicImage.astro";
import { HOME_DATA } from "../static/Home.data";
import { NAVBAR_DATA } from "../static/Navbar.data";
import { splitParagraph } from "../utils/UtilFunctions";
import SwiperTestimonios from '../components/SwiperTestimonios.astro';
import TrackingForm from '../components/TrackingForm.vue';

const cotizadorOption = NAVBAR_DATA.acciones.find((a) => a.texto.includes("Cotizador"))!;
const userOption = NAVBAR_DATA.acciones.find((a) => a.texto.includes("Zona clientes"))!;
---

<Layout title="Igo Courier, tu solución confiable para envíos locales urgentes">
  <div class="flex flex-col bg-white dark:bg-gray-900">
    <!-- Start block 1 - Hero -->
    {
      HOME_DATA.section_hero && HOME_DATA.section_hero.visible && (
        <section id="#home" class="bg-white dark:bg-gray-900">
          <div class="grid max-w-screen-xl mx-auto lg:gap-8 gap-4 lg:grid-cols-12 sm:py-32 py-16 px-4 sm:px-3">
            <div class="mr-auto place-self-center lg:col-span-6 lg:order-1 order-2">
              <h1
                class="text-pretty max-w-xl mb-4 text-2xl font-extrabold leading-none tracking-tight md:text-3xl xl:text-5xl dark:text-white transition-all
                  text-center md:text-left animate-fade-up animate-once animate-duration-500 animate-delay-[50ms] animate-ease-in-out"
              >
                {HOME_DATA.section_hero.title}
              </h1>
              {splitParagraph(HOME_DATA.section_hero.description, "#br#").map(
                (paraghaph) => (                
                  <h4
                    class="max-w-xl font-light text-gray-500 md:text-lg lg:text-xl dark:text-gray-300 text-pretty
                    text-center md:text-left animate-fade-up animate-once animate-duration-500 animate-delay-[100ms] animate-ease-in-out"
                  >
                    {paraghaph}
                  </h4>
                  <br />
                )
              )}
              <div class="flex flex-col space-y-4 sm:flex-row justify-around sm:justify-start sm:space-y-0 sm:space-x-4">
                <a
                  href={cotizadorOption.href}
                  class="animate-fade-down animate-once animate-duration-300 animate-ease-in inline-flex items-center justify-center px-4 py-2.5 text-base font-medium text-center
                    rounded-lg text-igo-light-text bg-igo-light-bg-button hover:bg-igo-hover-bg-button hover:text-igo-light-bg transition"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-math-symbols"
                  >
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M3 12l18 0" />
                    <path d="M12 3l0 18" />
                    <path d="M16.5 4.5l3 3" />
                    <path d="M19.5 4.5l-3 3" />
                    <path d="M6 4l0 4" />
                    <path d="M4 6l4 0" />
                    <path d="M18 16l.01 0" />
                    <path d="M18 20l.01 0" />
                    <path d="M4 18l4 0" />
                  </svg>
                  <span class="ml-2">Cotizar</span>
                </a>
                <a
                  href={userOption.href}
                  target={userOption.target}
                  class="animate-fade-down animate-once animate-duration-300 animate-ease-in inline-flex items-center justify-center px-4 py-2.5 text-base font-medium text-center
                  rounded-lg text-white bg-igo-dark-bg dark:text-black dark:bg-igo-light-bg transition"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-package-export"
                  >
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M12 21l-8 -4.5v-9l8 -4.5l8 4.5v4.5" />
                    <path d="M12 12l8 -4.5" />
                    <path d="M12 12v9" />
                    <path d="M12 12l-8 -4.5" />
                    <path d="M15 18h7" />
                    <path d="M19 15l3 3l-3 3" />
                  </svg>
                  <span class="ml-2">Hacer un envío</span>
                </a>
              </div>
            </div>
            <div class="lg:mt-0 lg:col-span-6 transition lg:order-2 order-1">
              <DynamicImage
                imagePath={HOME_DATA.section_hero.imageSrc}                
                altText="Igo Courier Hero"                
                classList="animate-fade-right animate-once animate-duration-500 animate-delay-[150ms] animate-ease-in"
                loadingType="eager"
              />
            </div>
          </div>
        </section>
      )
    }

    <!-- End block 1 -->
    <!-- Start block 2 - Tracking -->
    {
      HOME_DATA.section_tracking.visible && (
        <section id="rastrear-envio" class="bg-igo-bg-1 dark:bg-igo-bg-3 transition">
          <div class="sm:py-32 py-16 px-4 lg:px-6 mx-auto max-w-screen-xl">
            <div class="w-full mb-4 lg:mb-8">
              <h2 class="mb-4 sm:text-4xl text-2xl tracking-tight font-extrabold text-white text-center">
                {HOME_DATA.section_tracking.title}
              </h2>
              <p class="text-white sm:text-xl text-center">
                {HOME_DATA.section_tracking.description}
              </p>
            </div>
      
            <div
              class="w-full flex flex-col md:flex-row justify-between gap-5 my-8">
              <div class="p-3 flex flex-col items-center gap-2">
                <div class="border-2 border-igo-bg-2 rounded-3xl p-0 relative w-auto">
                  <div class="absolute top-3 left-3">
                    <div class="flex justify-center items-center w-8 h-8 rounded-full bg-igo-bg-2 text-igo-light-bg">
                      <p class="text-lg">1</p>
                    </div>
                  </div>
                  <DynamicImage imagePath="/src/assets/images/inicio-tracking-paso-1.png" altText="tracking-paso-1"
                    classList="rounded-3xl bg-cover max-w-80 max-h-[186px] w-[320px] h-[186px]" loadingType='eager' />
                </div>
                <p class="text-white text-md dark:text-white text-center sm:px-32 px-4">
                  Ubica el número de tracking en el comprobante de pago
                </p>
              </div>
              <div class="p-3 flex flex-col items-center gap-2">
                <div class="border-2 border-igo-bg-2 rounded-3xl p-0 relative w-auto">
                  <div class="absolute top-3 left-3">
                    <div class="flex justify-center items-center w-8 h-8 rounded-full bg-igo-bg-2 text-igo-light-bg">
                      <p class="text-lg">2</p>
                    </div>
                  </div>
                  <DynamicImage imagePath="/src/assets/images/inicio-tracking-paso-2.png" altText="tracking-paso-2"
                    classList="rounded-3xl bg-cover max-w-80 max-h-[186px] w-[320px] h-[186px]" loadingType='eager' />
                </div>
                <p class="text-white text-md dark:text-white text-center sm:px-32 px-4">
                  Ingresa el número de tracking (sin el sufijo "TR-"), y finalmente, presiona "Buscar"
                </p>
              </div>
            </div>

            <TrackingForm client:load />                 

          </div>
        </section>
      )
    }
    <!-- End block 2 -->
    <!-- Start block 3 - Services -->
    { 
      HOME_DATA.section_servicios.visible && (
        <section id="servicios" class="bg-white dark:bg-gray-900 transition">
          <div class="sm:py-32 py-16 px-4 lg:px-6 mx-auto max-w-screen-xl">
            <div class="w-full mb-8 lg:mb-16">
              <h2 class="mb-4 sm:text-4xl text-3xl tracking-tight font-extrabold text-gray-900 dark:text-white text-center">
                {HOME_DATA.section_servicios.title}
              </h2>
              <p class="text-gray-500 sm:text-xl dark:text-gray-300 text-center">
                {HOME_DATA.section_servicios.description}
              </p>
            </div>
            <div class="space-y-8 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-12 gap-15 md:space-y-0 service-list">
              {
                HOME_DATA.section_servicios.services.map(service => (
                  <div id={service.id}
                    class="service-item border-2 border-igo-bg-2 rounded-3xl flex flex-col justify-evenly h-full"
                    >
                    <div class="px-2 py-3">
                      <p
                        class="sm:text-4xl text-3xl font-bold text-igo-light-text dark:text-igo-hover-text-button text-left px-2">
                        <span class="text-2xl font-light text-black dark:text-white">Envío</span><br /> {service.title}
                      </p>
                    </div>
                    <div class="px-2 py-3">
                      <p class="text-gray-500 dark:text-gray-300 text-pretty px-2">
                        {service.description}
                      </p>
                    </div>
                    <div class="px-2 py-3">
                      <p class="text-igo-light-text dark:text-igo-hover-text-button text-pretty px-2">
                        Recomendado para:
                      </p>
                      <ul class="px-2 text-igo-light-text dark:text-igo-hover-text-button">
                        {
                          service.for.map(item => (
                            <li class="flex items-center">
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-corner-down-right-double">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M4 5v6a3 3 0 0 0 3 3h7" />
                                <path d="M10 10l4 4l-4 4m5 -8l4 4l-4 4" />
                              </svg>
                              <span class="ml-2">{item}</span>
                            </li>
                          ))
                        }
                      </ul>
                    </div>
                    <div class="px-2 py-3 flex justify-end">
                      <a href={service.href} target="_self" class="animate-fade-down animate-once animate-duration-300 animate-ease-in inline-flex items-center justify-center px-4 py-2.5 text-base font-medium text-center
                      rounded-lg text-igo-light-text dark:text-white transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                          class="icon icon-tabler icons-tabler-outline icon-tabler-square-plus">
                          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                          <path d="M9 12h6" />
                          <path d="M12 9v6" />
                          <path d="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14z" />
                        </svg>
                        <span class="ml-2">Ver más</span>
                      </a>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </section>
      )
    }

    <!-- End block3 -->
    <!-- Start block 4 - ¿Why choose us? -->
    {
      HOME_DATA.section_porque_elegirnos.visible && (
        <section id="por-que-elegirnos" class="bg-white dark:bg-gray-900 transition">
          <div class="sm:py-32 py-16 px-4 lg:px-6 mx-auto max-w-screen-xl">
            <div class="pt-14 pb-36 rounded-3xl bg-igo-bg-1 dark:bg-igo-bg-3">
              <h2 
                class="mb-4 sm:text-4xl text-3xl tracking-tight font-extrabold text-white dark:text-white text-center">
                {HOME_DATA.section_porque_elegirnos.title}
              </h2>
            </div>
            <div
              class="md:grid flex flex-col md:grid-cols-2 lg:grid-cols-3 gap-12 -m-32 pb-20 sm:px-16 px-4 mx-auto max-w-screen-xl">
              {
                HOME_DATA.section_porque_elegirnos.statements.map((statement, idx) => (
                  <div
                    class="bg-igo-light-bg dark:bg-gray-900 p-5 rounded-3xl border-2 border-igo-bg-2">
                    <div class="flex justify-center items-center w-8 h-8 rounded-full bg-igo-bg-2 text-igo-light-bg">
                      <p class="text-lg">{idx + 1}</p>
                    </div>
                    <div
                      class="flex justify-center items-center mb-4 w-20 h-20 rounded-full bg-primary-100 dark:bg-primary-900 mx-auto">
                      <DynamicImage classList="w-20 h-20 text-primary-600 dark:text-primary-300 transition aspect-square"
                        imagePath={statement.imageSrc} altText={statement.id} loadingType="lazy" />                        
                    </div>
                    <h3 class="mb-2 text-xl font-bold sm:text-left text-center dark:text-igo-light-icon">
                      {statement.title}
                    </h3>
                    <p class="text-gray-500 dark:text-igo-dark-text text-center sm:text-left text-balance">
                      {statement.description}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </section>
      )
    }
    <!-- End block 4 -->
    <!-- Start block 5 - Statistics -->
    {
      HOME_DATA.section_stadisticas.visible && (
        <section id="estadisticas" class="bg-white dark:bg-gray-900">
          <div class="py-16 sm:pt-16 sm:pb-10 px-4 lg:px-6 mx-auto max-w-screen-xl">
            <div class="w-full">
              <div class="flex flex-col md:flex-row justify-center items-start gap-5 sm:gap-0">
                <DynamicImage imagePath={HOME_DATA.section_stadisticas.imageSrc} altText={HOME_DATA.section_stadisticas.title} loadingType="lazy"
                  classList="animate-fade-right animate-once animate-duration-500 animate-delay-[150ms] animate-ease-in" />
                <div class="flex flex-col justify-start h-full gap-10 sm:mt-8 mt-2">
                  <h2
                    class="sm:text-4xl text-3xl tracking-tight font-extrabold text-gray-900 dark:text-white text-center sm:text-left">
                    {HOME_DATA.section_stadisticas.title}
                  </h2>
                  <p class="text-gray-500 sm:text-xl dark:text-gray-300 text-center sm:text-left">
                    {HOME_DATA.section_stadisticas.description}
                  </p>
                </div>
              </div>
            </div>
            <div
              class="max-w-screen-xl px-4 py-8 mx-auto text-center lg:py-12 lg:px-6">
              <dl class="grid max-w-screen-md gap-8 mx-auto text-gray-900 sm:grid-cols-3 dark:text-white">
                {
                  HOME_DATA.section_stadisticas.statistics.map(statistic => (
                    <div class="flex flex-col items-center justify-center">
                      <dt class="mb-2 text-3xl md:text-4xl font-extrabold text-igo-hover-text-button">
                        <span>{statistic.value}</span>{statistic.unit}+
                      </dt>
                      <dd class="font-light text-gray-500 dark:text-gray-300">{statistic.description}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
        </section>
      )
    }
    <!-- End block 5 -->
    <!-- Start block 6 - Testimonials -->
    {
      HOME_DATA.section_testimonios.visible && (
        <section id="testimonios" class="bg-white dark:bg-gray-900">
          <div class="sm:py-32 py-16 px-4 lg:px-6 mx-auto max-w-screen-xl text-center">
            <div class="mx-auto max-w-screen-sm">
              <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white">
                {HOME_DATA.section_testimonios.title}
              </h2>
              <p class="mb-8 font-light text-gray-500 lg:mb-16 sm:text-xl dark:text-gray-300">
                {HOME_DATA.section_testimonios.description}
              </p>
            </div>        
            <SwiperTestimonios testimonios={HOME_DATA.section_testimonios.testimonios}></SwiperTestimonios>
          </div>
        </section>
      )
    }
    <!-- End block 6 -->
  </div>
</Layout>
<style>
</style>
<script>
</script>