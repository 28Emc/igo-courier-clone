---
import "@fontsource/poppins";
import { FOOTER_DATA } from "../static/Footer.data";
import { NAVBAR_DATA } from "../static/Navbar.data";
import { Image } from "astro:assets";
import LogoBlack from "../assets/images/logo-black.svg";

const cotizadorOption = NAVBAR_DATA.acciones.find((a) =>
  a.texto.includes("Cotizador")
)!;
---

<footer class="bg-footer dark:bg-gray-900">
  <div
    class="mx-auto max-w-screen-xl px-4 pb-10 pt-72 animate-flip-up animate-once animate-duration-[500ms] animate-delay-100 animate-ease-in-out"
  >
    <div class="md:flex md:justify-between pb-16">
      <div class="mb-16 md:mb-0 flex flex-col justify-between">
        <a href="/" class="flex items-center justify-center">
          <Image
            src={LogoBlack}
            width={115}
            height={144}
            class="sm:mr-1 mr-3 animate-flip-down animate-once animate-duration-[500ms] animate-delay-100 animate-ease-in-out"
            alt="Igo Courier Logo Black"
            loading="eager"
          />
        </a>
        <div>
          <div
            class="flex mt-4 space-x-6 justify-center items-center sm:gap-4 gap-2 sm:mt-0"
          >
            {
              FOOTER_DATA.redesSociales.map((redSocial, idx) => (
                <a
                  aria-label={idx.toString()}
                  id={idx.toString()}
                  href={redSocial.href}
                  class="text-white hover:text-igo-light-icon transition animate-flip-down animate-once animate-duration-[500ms] animate-delay-100 animate-ease-in-out"
                >
                  <Fragment set:html={redSocial.svg} />
                </a>
              ))
            }
          </div>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:gap-6 sm:grid-cols-3">
        {
          FOOTER_DATA.secciones.map((seccion) => (
            <div>
              <h2 class="mb-6 text-md font-bold text-igo-light-icon uppercase animate-fade-down animate-once animate-duration-[500ms] animate-ease-in-out">
                {seccion.texto}
              </h2>
              <ul class="text-white">
                {seccion.elementos.map((elemento) => (
                  <li class="mb-4 animate-fade-down animate-once animate-duration-[500ms] animate-delay-100 animate-ease-in-out group">
                    <a
                      href={elemento.href}
                      target={elemento.externalUrl ? "_blank" : "_self"}
                    >
                      <span class="bg-left-bottom bg-gradient-to-r from-igo-light-bg to-igo-light-bg bg-[length:0%_2px] bg-no-repeat group-hover:bg-[length:100%_2px] transition-all duration-200 ease-out">
                        {elemento.texto}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div
      class="flex flex-col sm:flex-row items-center sm:justify-between justify-center gap-16"
    >
      <p class="text-white italic sm:text-left text-center sm:pr-16 pr-0">
        En IGO COURIER, nos dedicamos a ofrecer un servicio de envíos confiable,
        eficiente y personalizado que supera las expectativas de nuestros
        clientes.
      </p>
      <a
        href={cotizadorOption.href}
        class="animate-fade-down animate-once animate-duration-300 animate-ease-in inline-flex items-center justify-center px-4 py-2.5 text-base font-medium text-center
              rounded-lg text-igo-light-text bg-igo-light-bg-button transition w-full sm:w-auto"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="icon icon-tabler icons-tabler-outline icon-tabler-math-symbols"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M3 12l18 0"></path>
          <path d="M12 3l0 18"></path>
          <path d="M16.5 4.5l3 3"></path>
          <path d="M19.5 4.5l-3 3"></path>
          <path d="M6 4l0 4"></path>
          <path d="M4 6l4 0"></path>
          <path d="M18 16l.01 0"></path>
          <path d="M18 20l.01 0"></path>
          <path d="M4 18l4 0"></path>
        </svg>
        <span class="ml-2">Cotizar</span>
      </a>
    </div>
    <hr
      class="my-6 border-white sm:mx-auto lg:my-8 animate-flip-down animate-once animate-duration-[500ms] animate-delay-100 animate-ease-in-out"
    />
    <div
      class="flex items-center sm:justify-start justify-center sm:pb-16 pb-10"
    >
      <span
        class="text-sm text-white sm:text-center animate-flip-down animate-once animate-duration-[500ms] animate-delay-100 animate-ease-in-out"
      >
        {FOOTER_DATA.copyrightDisclaimer}
      </span>
    </div>
  </div>
</footer>
<style>
  .bg-footer {
    background-image: url("../assets/images/inicio-bg-footer.svg");
    background-repeat: no-repeat;
    background-position: top;
    background-size: cover;
  }
</style>
<script>
</script>
